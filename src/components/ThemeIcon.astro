---

---

<div class="theme-control">
  <button
    id="themeToggle"
    class="theme-toggle"
    type="button"
    aria-label="Switch to dark mode"
    title="Switch to dark mode"
  >
    <svg
      class="theme-toggle-icon"
      data-theme-icon="moon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M20.2 15.4A8.5 8.5 0 0 1 8.6 3.8a8.6 8.6 0 1 0 11.6 11.6Z"></path>
    </svg>
    <svg
      class="theme-toggle-icon"
      data-theme-icon="sun"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
      hidden
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"
      ></path>
    </svg>
  </button>
</div>

<script is:inline>
  (() => {
    const controllerKey = "__themeToggleController";
    const existingController = window[controllerKey];

    if (existingController) {
      existingController.refresh();
      return;
    }

    const storageKey = "theme";
    const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
    const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    let theme = "light";
    let followsSystem = true;

    try {
      const storedTheme = window.localStorage.getItem(storageKey);
      if (storedTheme === "light" || storedTheme === "dark") {
        theme = storedTheme;
        followsSystem = false;
      }
    } catch {
      // A blocked storage API should not prevent using the system preference.
    }

    const getResolvedTheme = () => (followsSystem ? (mediaQuery.matches ? "dark" : "light") : theme);

    const refresh = () => {
      const isDark = getResolvedTheme() === "dark";
      document.documentElement.classList.toggle("dark", isDark);

      const toggle = document.getElementById("themeToggle");
      const actionLabel = isDark ? "Switch to light mode" : "Switch to dark mode";
      toggle?.setAttribute("aria-label", actionLabel);
      toggle?.setAttribute("title", actionLabel);
      toggle?.querySelector('[data-theme-icon="moon"]')?.toggleAttribute("hidden", isDark);
      toggle?.querySelector('[data-theme-icon="sun"]')?.toggleAttribute("hidden", !isDark);
    };

    const toggleTheme = () => {
      theme = getResolvedTheme() === "dark" ? "light" : "dark";
      followsSystem = false;
      try {
        window.localStorage.setItem(storageKey, theme);
      } catch {
        // Keep the toggle responsive even when storage is unavailable.
      }
      refresh();

      const toggle = document.getElementById("themeToggle");
      toggle?.classList.remove("is-switching");
      if (toggle && !reducedMotionQuery.matches) {
        void toggle.offsetWidth;
        toggle.classList.add("is-switching");
      }
    };

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (target?.closest("#themeToggle")) toggleTheme();
    });

    mediaQuery.addEventListener("change", () => {
      if (followsSystem) refresh();
    });

    document.addEventListener("astro:page-load", refresh);
    window[controllerKey] = { refresh };
    refresh();
  })();
</script>
